+        /** SF64 extension: alpha plane has the same stride/dimensions as texture.
+         * Alpha endpoints describe the fragment opacity at texel alpha 0/255.
+         * A null plane samples alpha 255. Fully transparent fragments never
+         * update color or depth. This affects 3D draws only. */
+        void setFragmentAlpha(const uint8_t* plane = nullptr, uint8_t at0 = 255,
+                              uint8_t at255 = 255, uint8_t cutoff = 1) {
+            _uni.texture_alpha=plane; _uni.fragment_alpha0=at0;
+            _uni.fragment_alpha255=at255; _uni.fragment_alpha_cutoff=cutoff;
+        }
+        void setFragmentDepth(bool compare = true, bool write = true) {
+            _uni.depth_compare=compare; _uni.depth_write=write;
+        }
